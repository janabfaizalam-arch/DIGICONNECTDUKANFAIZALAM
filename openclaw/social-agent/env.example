# Environment for the DigiConnect Dukan social agent.
# Copy to ~/.openclaw/.env on the host (or the host's environment settings) and fill in.
# Never commit the filled-in copy. A platform with any value blank is skipped.
#
# The platform names below are the SAME as the website's Vercel variables
# (docs/MARKETING_AGENTS.md), so you can copy the values across.

# --- Agent chat (Telegram) -------------------------------------------------
# New bot from @BotFather, used only for you <-> agent chat.
DUKAN_DOST_TELEGRAM_TOKEN=
# Your numeric Telegram user id (message @userinfobot to get it).
OWNER_TELEGRAM_ID=

# --- Posters ---------------------------------------------------------------
GEMINI_API_KEY=

# --- Website ---------------------------------------------------------------
SITE_URL=https://www.rnos.in

# --- Facebook Page + Instagram ---------------------------------------------
# Permissions: pages_manage_posts, pages_read_engagement, pages_manage_engagement,
# instagram_basic, instagram_content_publish, instagram_manage_comments
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_GRAPH_VERSION=v23.0

# --- Threads ---------------------------------------------------------------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- X (Twitter) -----------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- LinkedIn --------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
# urn:li:organization:<id>  or  urn:li:person:<id>
LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_VERSION=202509

# --- Telegram public channel (the bot must be a channel admin) -------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@yourchannel

# --- Pinterest -------------------------------------------------------------
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
