{
  "name": "digiconnect-dukan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "npx vitest run",
    "test:crm-leads": "npx vitest run src/lib/crm/leads.test.ts src/lib/crm/lead-workflow.test.ts src/lib/crm/lead-convert.contract.test.ts src/app/api/ap/leads/route.test.ts",
    "test:crm-comms": "npx vitest run src/lib/communications src/lib/whatsapp/application-notify.test.ts",
    "test:crm-automation": "npx vitest run src/lib/automation src/lib/communications/comms.contract.test.ts",
    "test:security-advisor": "npx vitest run src/lib/supabase/security-advisor-remediation.contract.test.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "smoke": "node scripts/smoke-test.mjs",
    "build:print-station": "node scripts/build-print-station.mjs",
    "migrate:final-docs:dry-run": "node --experimental-strip-types --env-file=.env.local scripts/migrate-legacy-final-documents.ts --dry-run",
    "migrate:final-docs:inventory": "node --experimental-strip-types --env-file=.env.local scripts/migrate-legacy-final-documents.ts --dry-run --inventory-only --allow-linked-read",
    "snapshot:final-docs": "node --env-file=.env.local scripts/pre-migration-final-docs-snapshot.mjs",
    "verify:final-docs-access": "node --env-file=.env.local scripts/verify-final-document-access.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-select": "^2.2.5",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/qrcode.react": "^1.0.5",
    "@vercel/analytics": "^2.0.1",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.511.0",
    "next": "^15.5.5",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.5",
    "postcss": "^8.5.6",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
