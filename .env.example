NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staging-only migration tooling (never set these against production)
# SUPABASE_TARGET_ENV=staging
# ALLOWED_STAGING_SUPABASE_PROJECT_REF=<staging-project-ref>
# STAGING_DATABASE_URL=postgresql://...
# Optional role JWTs for access verification scripts:
# STAGING_CUSTOMER_ACCESS_TOKEN=
# STAGING_AP_ACCESS_TOKEN=
# STAGING_ADMIN_ACCESS_TOKEN=

# Final document signed URL TTLs (seconds)
# ADMIN_FINAL_DOCUMENT_URL_TTL_SECONDS=600
# WHATSAPP_FINAL_DOCUMENT_URL_TTL_SECONDS=900

# Customer PIN HMAC (min 32 chars) — never expose to browser
AUTH_HMAC_SECRET=

# Admin allowlist (comma-separated). Primary admin is always Faiz Alam.
ADMIN_EMAILS=janabfaizalam@gmail.com
# Optional bootstrap (used by scripts/ensure-primary-admin.mjs only):
# PRIMARY_ADMIN_PASSWORD=
# PRIMARY_ADMIN_PIN=

# --- WhatsApp: Meta WhatsApp Cloud API (SERVER-ONLY — never NEXT_PUBLIC_) ---
# Every outgoing WhatsApp (OTP, application updates, invoices, renewals) goes to
# POST graph.facebook.com/{version}/{META_WHATSAPP_PHONE_NUMBER_ID}/messages.
# Unset credentials → configuration_required, nothing sent.
# From developers.facebook.com → app → WhatsApp → API Setup. Use a System User
# permanent token (Business Settings → System users), not the 24-hour one.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
# WhatsApp Business Account ID — only for the live template-status check in admin diagnostics.
META_WHATSAPP_WABA_ID=
# META_WHATSAPP_API_VERSION=v23.0
# Webhook: callback https://<site>/api/webhooks/meta-whatsapp, field "messages".
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App settings → Basic → App secret. Verifies X-Hub-Signature-256 on every webhook POST.
META_APP_SECRET=

# Templates (src/lib/whatsapp/template-registry.ts). Defaults: application updates →
# `application_status` (Hindi, "hi"); OTP → login_otp / signup_otp / password_reset ("en").
# Override only when the APPROVED template in WhatsApp Manager has a different name or language:
# META_WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_TEMPLATE_APPLICATION_UPDATE=application_status
# WHATSAPP_TEMPLATE_APPLICATION_UPDATE_LANGUAGE=hi
# WHATSAPP_TEMPLATE_LOGIN_OTP=login_otp
# WHATSAPP_TEMPLATE_LOGIN_OTP_LANGUAGE=en
# WHATSAPP_TEMPLATE_SIGNUP_OTP=signup_otp
# WHATSAPP_TEMPLATE_PASSWORD_RESET=password_reset
# Per application event (falls back to application_update), e.g. a template with a document header:
# WHATSAPP_TEMPLATE_FINAL_DOCUMENT=
# WHATSAPP_TEMPLATE_INVOICE_GENERATED=
# WHATSAPP_TEMPLATE_RENEWAL_REMINDER=

# Outbox cron (SERVER-ONLY, min 16 chars). Prefer COMMS_CRON_SECRET.
# If COMMS_CRON_SECRET is *set* but blank, auth fails — does NOT fall through to CRON_SECRET.
# Legacy fallback: CRON_SECRET only when COMMS_CRON_SECRET is unset.
# Auth header only: Authorization: Bearer <secret>. Never query/body/cookie.
# /api/cron/comms-outbox is NOT registered in vercel.json until approved.
# COMMS_CRON_SECRET=
# CRON_SECRET=


# Google Sheets live office CRM (service account — never expose to browser)
# Share the spreadsheet with the service account email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key; use \n for newlines in env UIs:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional dedicated secret for /api/crm-sync (falls back to CRON_SECRET)
# CRM_SYNC_SECRET=

# Non-OTP CRM notification delivery mode (SERVER-ONLY). Never accept from browser.
# FAIL-CLOSED: unset, blank, or unknown → disabled (no live non-OTP CRM WhatsApp send).
# Exact values after trim+lowercase:
#   queue    = enqueue only; outbox processor sends (requires migration + processor operational)
#   direct   = temporary compatibility — sync send in-request; must be EXPLICITLY set
#   disabled = no send; optional configuration_required audit only
# OTP / signup / login OTP does NOT use this variable.
# Leave empty or set disabled until queue is verified in staging.
CRM_NOTIFICATION_DELIVERY_MODE=disabled
# CRM_NOTIFICATION_DELIVERY_MODE=queue
# CRM_NOTIFICATION_DELIVERY_MODE=direct

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# AI (Google Gemini). Server-only — never give this a NEXT_PUBLIC_ prefix.
# Read at call time inside src/lib/ai/*, which is `server-only`, so it never
# reaches a browser bundle. Two features use it, and both degrade to a plain
# message rather than breaking when it is unset:
#   - Smart Print photo editing (/api/ai/process-photo)
#   - Drafting partner service copy (/api/admin/agent-services/ai-draft)
GEMINI_API_KEY=

# --- Marketing agents (SERVER-ONLY) — see docs/MARKETING_AGENTS.md ---
# Fail-closed: disabled (default) | draft (make posts, post nowhere) | live (post everywhere configured)
# Runs daily at 10:00 IST via /api/cron/marketing-agents (needs CRON_SECRET). Uses GEMINI_API_KEY.
MARKETING_AGENTS_MODE=disabled
# Optional: pin models. Unset = newest Gemini Flash the key can use, picked automatically.
# MARKETING_AGENTS_TEXT_MODEL=gemini-3.8-flash
# MARKETING_AGENTS_IMAGE_MODEL=gemini-3.8-flash-image
# MARKETING_BRAND_NAME=DigiConnect Dukan
# A platform is used only when all of its variables are set.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
LINKEDIN_ACCESS_TOKEN=
# urn:li:organization:<id> (company page) or urn:li:person:<id>
LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_VERSION=202509
TELEGRAM_BOT_TOKEN=
# @yourchannel or numeric chat id; the bot must be a channel admin
TELEGRAM_CHAT_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- Partner payouts (SERVER-ONLY) ---
# Money OUT is RazorpayX, a different product from the Razorpay keys above.
# The payment-gateway keys can take money in and cannot send it, so these are
# separate credentials from a separate activation (RazorpayX Lite or a
# RazorpayX-powered Current Account).
#
# Fail-closed: anything other than exactly `auto` means no payout is ever sent
# and partner withdrawals queue for an admin to pay by hand, as before.
RAZORPAYX_PAYOUT_MODE=disabled
# RAZORPAYX_PAYOUT_MODE=auto
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# YOUR RazorpayX account number that money leaves from — never a partner's.
RAZORPAYX_ACCOUNT_NUMBER=
# Set in the RazorpayX dashboard against /api/razorpayx/webhook. This is a
# different secret from RAZORPAY_WEBHOOK_SECRET above; sharing one would mean a
# leak of either could forge both.
RAZORPAYX_WEBHOOK_SECRET=

# The most a completed application will put in a partner's wallet without an
# admin approving it. Above this the commission is recorded as pending and
# waits in /admin/ap-commissions. Default 2000. Set 0 to hold everything.
# AP_AUTO_CREDIT_MAX=2000
