# ============================================================================
# DigiConnect Dukan — environment variables
# Copy to .env.local for development. Values here are placeholders only.
# Never commit real secrets. Never prefix server secrets with NEXT_PUBLIC_.
# ============================================================================

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://digiconnectdukanfaizalam.vercel.app

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — required by most API routes.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase OAuth providers (Google, Facebook) are configured in the Supabase
# Dashboard under Authentication -> Providers.

# ── Authentication (customer JWT sessions) ─────────────────────────────────
# Required in production. Used by /api/customer/auth/* and /api/customer-auth/*.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Admin access ────────────────────────────────────────────────────────────
# Comma-separated, server-only fallback allowlist of admin emails.
# NEXT_PUBLIC_ADMIN_EMAILS is no longer read anywhere — remove it from Vercel.
ADMIN_EMAILS=

# ── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public checkout key (same value as RAZORPAY_KEY_ID; safe to expose).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Referrals ───────────────────────────────────────────────────────────────
# HMAC key for referral attribution cookies. Recommended in production;
# falls back to a key derived from SUPABASE_SERVICE_ROLE_KEY when unset.
REFERRAL_SIGNING_SECRET=
# first_click (default) or last_click
REFERRAL_ATTRIBUTION_POLICY=first_click

# ── Cron jobs (Vercel Cron -> Authorization: Bearer <CRON_SECRET>) ─────────
CRON_SECRET=

# ── Print agent (local print worker in /print-agent) ───────────────────────
PRINT_AGENT_SECRET_KEY=

# ── WhatsApp OTP auth via AiSensy (optional) ────────────────────────────────
NEXT_PUBLIC_ENABLE_WHATSAPP_AUTH=false
AISENSY_PROJECT_API_KEY=
AISENSY_CAMPAIGN_NAME_LOGIN=login_otp
AISENSY_CAMPAIGN_NAME_SIGNUP=signup_otp
AISENSY_CAMPAIGN_NAME_RESET=password_reset

# ── Credit reports via Unifers (optional) ───────────────────────────────────
UNIFERS_API_TOKEN=
UNIFERS_API_BASE_URL=https://bifrost.unifers.ai

# ── Google reviews widget (optional) ────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
