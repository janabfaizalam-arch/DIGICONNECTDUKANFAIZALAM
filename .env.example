NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staging-only migration tooling (never set these against production)
# SUPABASE_TARGET_ENV=staging
# ALLOWED_STAGING_SUPABASE_PROJECT_REF=<staging-project-ref>
# STAGING_DATABASE_URL=postgresql://...
# Optional role JWTs for access verification scripts:
# STAGING_CUSTOMER_ACCESS_TOKEN=
# STAGING_AP_ACCESS_TOKEN=
# STAGING_ADMIN_ACCESS_TOKEN=

# Final document signed URL TTLs (seconds)
# ADMIN_FINAL_DOCUMENT_URL_TTL_SECONDS=600
# AISENSY_FINAL_DOCUMENT_URL_TTL_SECONDS=900
# AISENSY_APPLICATION_CAMPAIGN=
# AISENSY_FINAL_DOCUMENT_CAMPAIGN=

# Customer PIN HMAC (min 32 chars) — never expose to browser
AUTH_HMAC_SECRET=

# Admin allowlist (comma-separated). Primary admin is always Faiz Alam.
ADMIN_EMAILS=janabfaizalam@gmail.com
# Optional bootstrap (used by scripts/ensure-primary-admin.mjs only):
# PRIMARY_ADMIN_PASSWORD=
# PRIMARY_ADMIN_PIN=

# WhatsApp OTP delivery (AiSensy Campaign API — existing LIVE campaigns only)
WHATSAPP_PROVIDER=aisensy
AISENSY_API_KEY=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_SIGNUP_CAMPAIGN=signup_otp
AISENSY_PASSWORD_RESET_CAMPAIGN=password_reset
AISENSY_LOGIN_CAMPAIGN=login_otp

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
