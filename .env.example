NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staging-only migration tooling (never set these against production)
# SUPABASE_TARGET_ENV=staging
# ALLOWED_STAGING_SUPABASE_PROJECT_REF=<staging-project-ref>
# STAGING_DATABASE_URL=postgresql://...
# Optional role JWTs for access verification scripts:
# STAGING_CUSTOMER_ACCESS_TOKEN=
# STAGING_AP_ACCESS_TOKEN=
# STAGING_ADMIN_ACCESS_TOKEN=

# Final document signed URL TTLs (seconds)
# ADMIN_FINAL_DOCUMENT_URL_TTL_SECONDS=600
# AISENSY_FINAL_DOCUMENT_URL_TTL_SECONDS=900

# Customer PIN HMAC (min 32 chars) — never expose to browser
AUTH_HMAC_SECRET=

# Admin allowlist (comma-separated). Primary admin is always Faiz Alam.
ADMIN_EMAILS=janabfaizalam@gmail.com
# Optional bootstrap (used by scripts/ensure-primary-admin.mjs only):
# PRIMARY_ADMIN_PASSWORD=
# PRIMARY_ADMIN_PIN=

# --- WhatsApp / AiSensy / communications (SERVER-ONLY unless marked NEXT_PUBLIC_) ---
# Safely disabled when AISENSY_API_KEY is unset → configuration_required / no live send.
WHATSAPP_PROVIDER=aisensy
AISENSY_API_KEY=
# Optional alias used by some deployments:
# AISENSY_PROJECT_API_KEY=
# Prefer AISENSY_API_URL (production). AISENSY_API_BASE_URL is accepted as alias.
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
# AISENSY_API_BASE_URL=

# OTP campaign *names* (not secrets). Do not rename casually.
AISENSY_SIGNUP_CAMPAIGN=signup_otp
AISENSY_PASSWORD_RESET_CAMPAIGN=password_reset
AISENSY_LOGIN_CAMPAIGN=login_otp

# Application campaign names (fallback: AISENSY_APPLICATION_CAMPAIGN). Empty = use fallback.
AISENSY_APPLICATION_CAMPAIGN=application_update
AISENSY_APPLICATION_SUBMITTED_CAMPAIGN=
AISENSY_PAYMENT_PENDING_CAMPAIGN=
AISENSY_PAYMENT_SUCCESS_CAMPAIGN=
AISENSY_DOCUMENT_REQUIRED_CAMPAIGN=
AISENSY_DOCUMENT_RECEIVED_CAMPAIGN=
AISENSY_UNDER_REVIEW_CAMPAIGN=
AISENSY_PROCESSING_CAMPAIGN=
AISENSY_PROGRESS_UPDATE_CAMPAIGN=
AISENSY_OBJECTION_CAMPAIGN=
AISENSY_OBJECTION_RESOLVED_CAMPAIGN=
AISENSY_APPLICATION_COMPLETED_CAMPAIGN=
AISENSY_FINAL_DOCUMENT_CAMPAIGN=
AISENSY_PAYMENT_REMINDER_CAMPAIGN=

# Outbox cron (SERVER-ONLY, min 16 chars). Prefer COMMS_CRON_SECRET.
# If COMMS_CRON_SECRET is *set* but blank, auth fails — does NOT fall through to CRON_SECRET.
# Legacy fallback: CRON_SECRET only when COMMS_CRON_SECRET is unset.
# Auth header only: Authorization: Bearer <secret>. Never query/body/cookie.
# /api/cron/comms-outbox is NOT registered in vercel.json until approved.
# COMMS_CRON_SECRET=
# CRON_SECRET=

# Delivery webhook (SERVER-ONLY, min 16 chars). Header only:
#   x-aisensy-webhook-secret  (or x-webhook-secret)
# Query-string secrets rejected. Shared-secret only — no invented HMAC.
# Unset/blank → webhook 503 (safely disabled).
# AISENSY_WEBHOOK_SECRET=
# Optional status lookup URL template with {id} (diagnostics only)
# AISENSY_MESSAGE_STATUS_URL=

# Google Sheets live office CRM (service account — never expose to browser)
# Share the spreadsheet with the service account email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key; use \n for newlines in env UIs:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional dedicated secret for /api/crm-sync (falls back to CRON_SECRET)
# CRM_SYNC_SECRET=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
