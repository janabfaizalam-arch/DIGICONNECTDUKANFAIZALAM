# API settings of your DigiConnect Dukan website
API_BASE_URL=http://localhost:3000

# Secret authorization key matching PRINT_AGENT_SECRET_KEY on the server
AGENT_SECRET_KEY=print-agent-secret-xyz-789

# Unique ID identifying this machine/PC
AGENT_ID=shop-front-pc

# Optional: Physical printer name to target. If empty, the default system printer is used.
PRINTER_NAME=
